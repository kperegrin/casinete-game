{
  "name": "casinete-web-prototype",
  "version": "0.1.0",
  "description": "Casinete playable web prototype (host + clients)",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node server/index.js",
    "e2e": "node test/e2e.mjs && node test/e2e2.mjs",
    "slotsim": "node tools/slotsim.js",
    "tileset": "node tools/make-tileset.mjs",
    "start:fast": "node server/index.js --fast",
    "start:lan": "node server/index.js --port 3000",
    "build:exe": "node tools/build-exe.mjs --target win",
    "build:linux": "node tools/build-exe.mjs --target linux"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "1.56.1",
    "postject": "^1.0.0-alpha.6"
  }
}
